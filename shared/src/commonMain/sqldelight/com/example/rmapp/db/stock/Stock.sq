CREATE TABLE stock (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    productId INTEGER NOT NULL,
    quantity REAL NOT NULL DEFAULT 0,
    minimumThreshold REAL NOT NULL DEFAULT 0
);

getAllStock:
SELECT * FROM stock;

getStockByProduct:
SELECT * FROM stock
WHERE productId = ?;

insertStock:
INSERT INTO stock(productId, quantity, minimumThreshold)
VALUES (?, ?, ?);

updateStockQuantity:
UPDATE stock
SET quantity = quantity + ?
WHERE productId = ?;

setStockQuantity:
UPDATE stock
SET quantity = ?
WHERE productId = ?;

deleteStock:
DELETE FROM stock
WHERE id = ?;

getLowStock:
SELECT * FROM stock
WHERE quantity <= minimumThreshold;